[Unit]
Description=Fincra Payment Proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=proxy
WorkingDirectory=/opt/fincra-proxy
EnvironmentFile=/opt/fincra-proxy/.env
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/fincra-proxy
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
