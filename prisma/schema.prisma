generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model CallbackRequest {
  id        Int      @id @default(autoincrement())
  fullName  String
  phone     String
  email     String?
  service   String
  message   String?
  status    String   @default("pending")
  createdAt DateTime @default(now())
}
